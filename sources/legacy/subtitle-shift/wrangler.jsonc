{
  "name": "glossquote-subtitle-shift",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist-production",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": false
  },
  "routes": [
    { "pattern": "subtitles.glossquote.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
