{
  "name": "glossquote-file-checksum",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  },
  "assets": {
    "directory": "./dist-production",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "checksum.glossquote.com", "custom_domain": true }
  ]
}
