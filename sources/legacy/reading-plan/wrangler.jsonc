{
  "name": "glossquote-reading-plan",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist-production",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "reading.glossquote.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  }
}
