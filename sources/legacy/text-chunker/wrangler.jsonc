{
  "name": "glossquote-text-chunker",
  "compatibility_date": "2026-10-13",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chunks.glossquote.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist-production",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": false
  },
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  }
}
