        "olderDraft": {
          "amount": "25",
          "unit": "m2"
        },
        "newerDraft": {
          "amount": "1.0001",
          "unit": "ping"
        },
        "olderLateResult": {
          "ping": 7.56,
          "m2": 25,
          "ft2": 269.1,
          "tatami": 15.4
        }
