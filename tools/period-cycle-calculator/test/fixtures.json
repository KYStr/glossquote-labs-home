    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為無效輸入，舊結果及所有下載立即失效。",
      "input": {
        "initial": {
          "lastPeriodStart": "2026-10-26",
          "cycleLength": "28",
          "periodLength": "5"
        },
        "edit": {
          "lastPeriodStart": "2026-10-26",
          "cycleLength": "36",
          "periodLength": "5"
        }
      },
      "expected": {
        "afterRun": {
          "state": "success",
          "reportAvailable": true
        },
        "afterEdit": {
          "state": "dirty",
          "reportAvailable": false
        },
        "afterRerun": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "RANGE",
            "field": "cycleLength",
            "row": null
          }
        }
      }
    },
