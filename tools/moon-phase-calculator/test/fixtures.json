    {
      "id": "err-offset-range",
      "kind": "core",
      "purpose": "+08:10 分鐘非 15 的倍數回 RANGE（field=utcOffset）",
      "input": { "date": "2026-11-09", "utcOffset": "+08:10" },
      "expected": { "ok": false, "error": { "code": "RANGE", "field": "utcOffset", "row": null } }
    },
    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為無效輸入，舊結果及所有下載立即失效。",
      "input": {
        "initial": { "date": "2000-01-06", "utcOffset": "+08:00" },
        "edit": { "date": "2023-02-29", "utcOffset": "+08:00" }
      },
      "expected": {
        "afterRun": { "state": "success", "reportAvailable": true },
        "afterEdit": { "state": "dirty", "reportAvailable": false },
        "afterRerun": {
          "state": "error",
          "reportAvailable": false,
          "error": { "code": "INVALID_DATE", "field": "date", "row": null }
        }
      }
    },
    {
      "id": "state-cancel-late",
      "kind": "controller",
      "purpose": "延遲成功後取消，舊回傳不能復活，重設回預設值。",
      "input": {
        "draft": { "date": "2000-01-06", "utcOffset": "+08:00" },
        "lateResult": {
          "julianDay": 2451550,
          "ageDays": 29.4,
          "phaseIndex": 0,
          "phaseZh": "新月",
          "phaseEn": "New Moon",
          "illuminationPercent": 0.0,
          "daysToNextNewMoon": 0.1,
          "nextNewMoonDate": "2000-01-06",
          "nextNewMoonDateLocal": "2000-01-06",
          "daysToNextFullMoon": 14.9,
          "nextFullMoonDate": "2000-01-21",
          "nextFullMoonDateLocal": "2000-01-21"
        }
      },
      "expected": {
        "whilePending": { "state": "busy", "reportAvailable": false },
        "afterCancel": {
          "state": "cancelled",
          "reportAvailable": false,
          "draft": { "date": "2000-01-06", "utcOffset": "+08:00" }
        },
        "afterLateResult": { "state": "cancelled", "reportAvailable": false },
        "afterReset": {
          "state": "empty",
          "reportAvailable": false,
          "draft": { "date": "", "utcOffset": "+08:00" }
        }
      }
    },
    {
      "id": "state-replace-late",
      "kind": "controller",
      "purpose": "新工作失敗後收到上一份工作的成功，保留目前錯誤。",
      "input": {
        "olderDraft": { "date": "2000-01-06", "utcOffset": "+08:00" },
        "newerDraft": { "date": "2023-02-29", "utcOffset": "+08:00" },
        "olderLateResult": {
          "julianDay": 2451550,
          "ageDays": 29.4,
          "phaseIndex": 0,
          "phaseZh": "新月",
          "phaseEn": "New Moon",
          "illuminationPercent": 0.0,
          "daysToNextNewMoon": 0.1,
          "nextNewMoonDate": "2000-01-06",
          "nextNewMoonDateLocal": "2000-01-06",
          "daysToNextFullMoon": 14.9,
          "nextFullMoonDate": "2000-01-21",
          "nextFullMoonDateLocal": "2000-01-21"
        }
      },
      "expected": {
        "afterNewerResult": {
          "state": "error",
          "reportAvailable": false,
          "error": { "code": "INVALID_DATE", "field": "date", "row": null }
        },
        "afterOlderLateResult": {
          "state": "error",
          "reportAvailable": false,
          "error": { "code": "INVALID_DATE", "field": "date", "row": null }
        }
      }
    }
  ]
