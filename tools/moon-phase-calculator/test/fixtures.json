      "id": "err-invalid-date",
      "kind": "core",
      "purpose": "2023-02-29 回 INVALID_DATE",
      "input": { "date": "2023-02-29", "utcOffset": "+08:00" },
      "expected": { "ok": false, "error": { "code": "INVALID_DATE", "field": "date", "row": null } }
