    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為賣超輸入，舊結果及所有下載立即失效。",
      "input": {
        "initial": {
          "feeRateBps": "0",
          "trades": [
            {
              "side": "buy",
              "shares": "100",
              "price": "10"
            },
            {
              "side": "buy",
              "shares": "100",
              "price": "20"
            },
            {
              "side": "sell",
              "shares": "150",
              "price": "25"
            }
          ]
        },
        "edit": {
          "feeRateBps": "0",
          "trades": [
            {
              "side": "buy",
              "shares": "100",
              "price": "10"
            },
            {
              "side": "sell",
              "shares": "101",
              "price": "12"
            }
          ]
        }
      },
      "expected": {
        "afterRun": {
          "state": "success",
          "reportAvailable": true
        },
        "afterEdit": {
          "state": "dirty",
          "reportAvailable": false
        },
        "afterRerun": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "OVERSOLD",
            "field": "trades",
            "row": 2
          }
        }
      }
    },
