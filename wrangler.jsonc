{
  "name": "glossquote-home",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "build": {
    "command": "node scripts/release.mjs"
  },
  "routes": [
    {
      "pattern": "glossquote.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist-production",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
