    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為無效輸入，舊結果及所有下載立即失效。",
      "input": {
        "initial": {
          "start": "0",
          "end": "10",
          "intervals": "0\t4\n3\t6\n8\t10"
        },
        "edit": {
          "start": "0",
          "end": "1",
          "intervals": "0\t1.001"
        }
      },
      "expected": {
        "afterRun": {
          "state": "success",
          "reportAvailable": true
        },
        "afterEdit": {
          "state": "dirty",
          "reportAvailable": false
        },
        "afterRerun": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "OUTSIDE",
            "field": "intervals",
            "row": 1
          }
        }
      }
    },
