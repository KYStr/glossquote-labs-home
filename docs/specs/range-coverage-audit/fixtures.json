    {
      "id": "gap-and-overlap",
      "kind": "core",
      "purpose": "同時有一個重疊及一個空段",
      "input": {
        "start": "0",
        "end": "10",
        "intervals": "0\t4\n3\t6\n8\t10"
      },
      "expected": {
        "ok": true,
        "result": {
          "spans": [
            {
              "from": "0",
              "to": "3",
              "depth": 1,
              "lines": [
                1
              ]
            },
            {
              "from": "3",
              "to": "4",
              "depth": 2,
              "lines": [
                1,
                2
              ]
            },
            {
              "from": "4",
              "to": "6",
              "depth": 1,
              "lines": [
                2
              ]
            },
            {
              "from": "6",
              "to": "8",
              "depth": 0,
              "lines": []
            },
            {
              "from": "8",
              "to": "10",
              "depth": 1,
              "lines": [
                3
              ]
            }
          ],
          "covered": "8",
          "uncovered": "2",
          "overlapped": "1"
        }
      }
    },
