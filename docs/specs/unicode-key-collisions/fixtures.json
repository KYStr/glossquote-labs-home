    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為無效輸入，舊結果及所有下載立即失效。",
      "input": {
        "initial": {
          "keys": "é\né\nB\né",
          "form": "NFC"
        },
        "edit": {
          "keys": "A\n\nB",
          "form": "NFC"
        }
      },
      "expected": {
        "afterRun": {
          "state": "success",
          "reportAvailable": true
        },
        "afterEdit": {
          "state": "dirty",
          "reportAvailable": false
        },
        "afterRerun": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "EMPTY_KEY",
            "field": "keys",
            "row": 2
          }
        }
      }
    },
