{
  "schemaVersion": 1,
  "specId": "spec-battery-swap-plan-20261109",
  "cases": [
    {
      "id": "battery-swap-plan.gaps-and-shortage",
      "kind": "solve",
      "input": {
        "charged": 3,
        "devices": [
          {
            "name": "A",
            "runtime": 30,
            "runs": [
              {
                "start": 0,
                "end": 20
              },
              {
                "start": 40,
                "end": 65
              }
            ]
          },
          {
            "name": "B",
            "runtime": 20,
            "runs": [
              {
                "start": 10,
                "end": 50
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "ok",
        "result": {
          "required": 4,
          "extra": 1,
          "unused": 0,
          "firstMissing": 4,
          "events": [
            {
              "minute": 0,
              "device": "A",
              "kind": "load",
              "pack": 1
            },
            {
              "minute": 10,
              "device": "B",
              "kind": "load",
              "pack": 2
            },
            {
              "minute": 30,
              "device": "B",
              "kind": "swap",
              "pack": 3
            },
            {
              "minute": 50,
              "device": "A",
              "kind": "swap",
              "pack": null
            }
          ]
        }
      },
      "derivation": "A 關閉時留 10 分，第二段至 50 用完。B 在 30 換一次，50 正好完工。"
    },
    {
      "id": "battery-swap-plan.simultaneous",
      "kind": "solve",
      "input": {
        "charged": 1,
        "devices": [
          {
            "name": "Z",
            "runtime": 10,
            "runs": [
              {
                "start": 5,
                "end": 10
              }
            ]
          },
          {
            "name": "A",
            "runtime": 10,
            "runs": [
              {
                "start": 5,
                "end": 10
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "ok",
        "result": {
          "required": 2,
          "extra": 1,
          "unused": 0,
          "firstMissing": 2,
          "events": [
            {
              "minute": 5,
              "device": "Z",
              "kind": "load",
              "pack": 1
            },
            {
              "minute": 5,
              "device": "A",
              "kind": "load",
              "pack": null
            }
          ]
        }
      },
      "derivation": "同分鐘依設備輸入序，Z 優先於 A。"
    },
    {
      "id": "battery-swap-plan.exact-end",
      "kind": "solve",
      "input": {
        "charged": 2,
        "devices": [
          {
            "name": "A",
            "runtime": 20,
            "runs": [
              {
                "start": 1420,
                "end": 1440
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "ok",
        "result": {
          "required": 1,
          "extra": 0,
          "unused": 1,
          "firstMissing": null,
          "events": [
            {
              "minute": 1420,
              "device": "A",
              "kind": "load",
              "pack": 1
            }
          ]
        }
      },
      "derivation": "24:00 剛用完且活動也結束，沒有新組事件。"
    },
    {
      "id": "battery-swap-plan.swap-after-gap",
      "kind": "solve",
      "input": {
        "charged": 2,
        "devices": [
          {
            "name": "A",
            "runtime": 10,
            "runs": [
              {
                "start": 20,
                "end": 21
              },
              {
                "start": 0,
                "end": 10
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "ok",
        "result": {
          "required": 2,
          "extra": 0,
          "unused": 0,
          "firstMissing": null,
          "events": [
            {
              "minute": 0,
              "device": "A",
              "kind": "load",
              "pack": 1
            },
            {
              "minute": 20,
              "device": "A",
              "kind": "swap",
              "pack": 2
            }
          ]
        }
      },
      "derivation": "原輸入未排序，先用 0–10。下一次運轉在 20 才換。"
    },
    {
      "id": "battery-swap-plan.zero-stock",
      "kind": "solve",
      "input": {
        "charged": 0,
        "devices": [
          {
            "name": "A",
            "runtime": 10,
            "runs": [
              {
                "start": 0,
                "end": 1
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "ok",
        "result": {
          "required": 1,
          "extra": 1,
          "unused": 0,
          "firstMissing": 1,
          "events": [
            {
              "minute": 0,
              "device": "A",
              "kind": "load",
              "pack": null
            }
          ]
        }
      },
      "derivation": "起始就需 1 組，庫存 0，首缺第 1 個事件。"
    },
    {
      "id": "battery-swap-plan.overlap",
      "kind": "solve",
      "input": {
        "charged": 2,
        "devices": [
          {
            "name": "A",
            "runtime": 10,
            "runs": [
              {
                "start": 0,
                "end": 20
              },
              {
                "start": 10,
                "end": 30
              }
            ]
          }
        ]
      },
      "expected": {
        "status": "error",
        "error": {
          "code": "OVERLAP",
          "path": "/devices/0/runs/1/start"
        }
      },
      "derivation": "同設備 10–20 被重複計入，第二段起點被拒。"
    },
    {
      "id": "battery-swap-plan.dirty-after-edit",
      "kind": "flow",
      "input": [
        {
          "type": "edit",
          "draft": {
            "charged": 3,
            "devices": [
              {
                "name": "A",
                "runtime": 30,
                "runs": [
                  {
                    "start": 0,
                    "end": 20
                  },
                  {
                    "start": 40,
                    "end": 65
                  }
                ]
              },
              {
                "name": "B",
                "runtime": 20,
                "runs": [
                  {
                    "start": 10,
                    "end": 50
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "run",
          "runId": 1
        },
        {
          "type": "settle",
          "runId": 1
        },
        {
          "type": "edit",
          "draft": {
            "charged": 1,
            "devices": [
              {
                "name": "Z",
                "runtime": 10,
                "runs": [
                  {
                    "start": 5,
                    "end": 10
                  }
                ]
              },
              {
                "name": "A",
                "runtime": 10,
                "runs": [
                  {
                    "start": 5,
                    "end": 10
                  }
                ]
              }
            ]
          }
        }
      ],
      "expected": {
        "phase": "dirty",
        "result": null
      },
      "derivation": "第一次結算可顯示，替換草稿後立刻失效。新草稿要重新執行才產生自己的結果。"
    },
    {
      "id": "battery-swap-plan.cancel-then-late",
      "kind": "flow",
      "input": [
        {
          "type": "edit",
          "draft": {
            "charged": 3,
            "devices": [
              {
                "name": "A",
                "runtime": 30,
                "runs": [
                  {
                    "start": 0,
                    "end": 20
                  },
                  {
                    "start": 40,
                    "end": 65
                  }
                ]
              },
              {
                "name": "B",
                "runtime": 20,
                "runs": [
                  {
                    "start": 10,
                    "end": 50
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "run",
          "runId": 1
        },
        {
          "type": "cancel"
        },
        {
          "type": "edit",
          "draft": {
            "charged": 1,
            "devices": [
              {
                "name": "Z",
                "runtime": 10,
                "runs": [
                  {
                    "start": 5,
                    "end": 10
                  }
                ]
              },
              {
                "name": "A",
                "runtime": 10,
                "runs": [
                  {
                    "start": 5,
                    "end": 10
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "run",
          "runId": 2
        },
        {
          "type": "settle",
          "runId": 2
        },
        {
          "type": "settle",
          "runId": 1
        }
      ],
      "expected": {
        "phase": "ready",
        "result": {
          "required": 2,
          "extra": 1,
          "unused": 0,
          "firstMissing": 2,
          "events": [
            {
              "minute": 5,
              "device": "Z",
              "kind": "load",
              "pack": 1
            },
            {
              "minute": 5,
              "device": "A",
              "kind": "load",
              "pack": null
            }
          ]
        }
      },
      "derivation": "取消令第一個 runId 失效。第二次完成後抵達的第一次回覆丟棄，保留第二個字面結果。"
    }
  ]
}
