      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為無效輸入，舊結果及所有下載立即失效。",
      "input": {
        "initial": {
          "budget": "5500",
          "timeout": "1000",
          "attemptLimit": "5",
          "initialDelay": "500",
          "factor": "2",
          "maxDelay": "1200"
        },
