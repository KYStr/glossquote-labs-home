  "cases": [
    {
      "id": "bounded-exponential",
      "kind": "core",
      "purpose": "延遲上限與第一次超界",
      "input": {
        "budget": "5500",
        "timeout": "1000",
        "attemptLimit": "5",
        "initialDelay": "500",
        "factor": "2",
        "maxDelay": "1200"
      },
      "expected": {
        "ok": true,
        "result": {
          "attempts": [
            {
              "number": 1,
              "delayMs": 0,
              "startMs": 0,
              "endMs": 1000
            },
            {
              "number": 2,
              "delayMs": 500,
              "startMs": 1500,
              "endMs": 2500
            },
            {
              "number": 3,
              "delayMs": 1000,
              "startMs": 3500,
              "endMs": 4500
            }
          ],
          "unspentMs": 1000,
          "nextRejected": {
            "number": 4,
            "startMs": 5700,
            "endMs": 6700
          }
        }
      }
    },
