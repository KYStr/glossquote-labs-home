    {
      "id": "state-cancel-late",
      "kind": "controller",
      "purpose": "延遲成功後取消，舊回傳不能復活，重設回預設值。",
      "input": {
        "draft": {
          "budget": "5500",
          "timeout": "1000",
          "attemptLimit": "5",
          "initialDelay": "500",
          "factor": "2",
          "maxDelay": "1200"
        },
        "lateResult": {
          "attempts": [
            {
              "number": 1,
              "delayMs": 0,
              "startMs": 0,
              "endMs": 1000
            },
            {
              "number": 2,
              "delayMs": 500,
              "startMs": 1500,
              "endMs": 2500
            },
            {
              "number": 3,
              "delayMs": 1000,
              "startMs": 3500,
              "endMs": 4500
            }
          ],
          "unspentMs": 1000,
          "nextRejected": {
            "number": 4,
            "startMs": 5700,
            "endMs": 6700
          }
        }
      },
      "expected": {
        "whilePending": {
          "state": "busy",
          "reportAvailable": false
        },
        "afterCancel": {
          "state": "cancelled",
          "reportAvailable": false,
          "draft": {
            "budget": "5500",
            "timeout": "1000",
            "attemptLimit": "5",
            "initialDelay": "500",
            "factor": "2",
            "maxDelay": "1200"
          }
        },
        "afterLateResult": {
          "state": "cancelled",
          "reportAvailable": false
        },
        "afterReset": {
          "state": "empty",
          "reportAvailable": false,
          "draft": {
            "budget": "10000",
            "timeout": "1500",
            "attemptLimit": "5",
            "initialDelay": "500",
            "factor": "2",
            "maxDelay": "2000"
          }
        }
      }
    },
