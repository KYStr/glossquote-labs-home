    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為永遠還不完的輸入，舊結果及所有下載立即失效，重跑得到 NEVER_PAYOFF。",
      "input": {
        "initial": {
          "balance": "1200.00",
          "aprPercent": "12",
          "mode": "payment",
          "monthlyPayment": "110.00",
          "targetMonths": "24"
        },
        "edit": {
          "balance": "5000.00",
          "aprPercent": "24",
          "mode": "payment",
          "monthlyPayment": "100.00",
          "targetMonths": "24"
        }
      },
      "expected": {
        "afterRun": {
          "state": "success",
          "reportAvailable": true
        },
        "afterEdit": {
          "state": "dirty",
          "reportAvailable": false
        },
        "afterRerun": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "NEVER_PAYOFF",
            "field": "monthlyPayment",
            "row": null
          }
        }
      }
    },
