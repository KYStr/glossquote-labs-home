        },
        "newerDraft": {
          "method": "declining", "price": "0", "years": "5", "salvagePercent": "10",
          "rate": "15", "usefulLife": "10", "tableRates": "20\n18\n15\n12\n10\n8\n8\n6\n6\n5"
        },
        "olderLateResult": {
          "method": "declining",
          "floorValue": 100000,
          "currentValue": 443705,
          "totalDepreciation": 556295,
          "totalDepreciationPercent": "55.63",
          "floorReachedYear": null,
          "schedule": [
            { "year": 1, "ratePercent": "15.00", "depreciation": 150000, "endValue": 850000, "floored": false },
            { "year": 2, "ratePercent": "15.00", "depreciation": 127500, "endValue": 722500, "floored": false },
            { "year": 3, "ratePercent": "15.00", "depreciation": 108375, "endValue": 614125, "floored": false },
            { "year": 4, "ratePercent": "15.00", "depreciation": 92119, "endValue": 522006, "floored": false },
            { "year": 5, "ratePercent": "15.00", "depreciation": 78301, "endValue": 443705, "floored": false }
          ]
        }
      },
      "expected": {
        "afterNewerResult": {
          "state": "error",
          "reportAvailable": false,
          "error": { "code": "RANGE", "field": "price", "row": null }
        },
        "afterOlderLateResult": {
          "state": "error",
          "reportAvailable": false,
          "error": { "code": "RANGE", "field": "price", "row": null }
        }
      }
    }
