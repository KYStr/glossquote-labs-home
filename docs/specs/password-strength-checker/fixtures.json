    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為空密碼，舊結果及所有下載立即失效。",
      "input": {
        "initial": {
          "password": "Tr0ub4dor&3"
        },
        "edit": {
          "password": ""
        }
      },
      "expected": {
        "afterRun": {
          "state": "success",
          "reportAvailable": true
        },
        "afterEdit": {
          "state": "dirty",
          "reportAvailable": false
        },
        "afterRerun": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "EMPTY",
            "field": "password",
            "row": null
          }
        }
      }
    },
    {
      "id": "state-cancel-late",
      "kind": "controller",
      "purpose": "延遲成功後取消，舊回傳不能復活，重設回預設值。",
      "input": {
        "draft": {
          "password": "Tr0ub4dor&3"
        },
        "lateResult": {
          "passwordLength": 11,
          "classes": [
            "lowercase",
            "uppercase",
            "digits",
            "symbols"
          ],
          "pool": 94,
          "baseEntropyBits": 72.1,
          "penalties": [],
          "totalPenaltyBits": 0,
          "finalEntropyBits": 72.1,
          "band": "strong",
          "crackTimeOnline": {
            "zh": "16038314310056.9 年",
            "en": "16038314310056.9 years"
          },
          "crackTimeOffline": {
            "zh": "16038.3 年",
            "en": "16038.3 years"
          },
          "suggestions": [
            "S_LENGTH"
          ]
        }
      },
      "expected": {
        "whilePending": {
          "state": "busy",
          "reportAvailable": false
        },
        "afterCancel": {
          "state": "cancelled",
          "reportAvailable": false,
          "draft": {
            "password": "Tr0ub4dor&3"
          }
        },
        "afterLateResult": {
          "state": "cancelled",
          "reportAvailable": false
        },
        "afterReset": {
          "state": "empty",
          "reportAvailable": false,
          "draft": {
            "password": ""
          }
        }
      }
    },
    {
