          "finalEntropyBits": 72.1,
          "band": "strong",
          "crackTimeOnline": {
            "zh": "16038314310056.9 年",
            "en": "16038314310056.9 years"
          },
          "crackTimeOffline": {
            "zh": "16038.3 年",
            "en": "16038.3 years"
          },
          "suggestions": [
            "S_LENGTH"
          ]
        }
      },
      "expected": {
        "afterNewerResult": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "EMPTY",
            "field": "password",
            "row": null
          }
        },
        "afterOlderLateResult": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "EMPTY",
            "field": "password",
            "row": null
          }
        }
      }
