      "input": {
        "olderDraft": {
          "password": "Tr0ub4dor&3"
        },
        "newerDraft": {
          "password": ""
        },
        "olderLateResult": {
          "passwordLength": 11,
          "classes": [
            "lowercase",
            "uppercase",
