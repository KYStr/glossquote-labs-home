          "rolls": [
            4,
            3
          ],
          "sum": 7,
          "total": 7
        }
      },
      "expected": {
        "whilePending": {
          "state": "busy",
          "reportAvailable": false
        },
        "afterCancel": {
          "state": "cancelled",
          "reportAvailable": false,
          "draft": {
            "notation": "2d6",
            "seed": "42"
          }
        },
        "afterLateResult": {
          "state": "cancelled",
          "reportAvailable": false
        },
        "afterReset": {
          "state": "empty",
          "reportAvailable": false,
          "draft": {
            "notation": "2d6",
            "seed": ""
          }
        }
      }
    },
