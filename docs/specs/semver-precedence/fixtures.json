      "expected": {
        "afterNewerResult": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "SEMVER_SYNTAX",
            "field": "left",
            "row": null
          }
        },
        "afterOlderLateResult": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "SEMVER_SYNTAX",
            "field": "left",
            "row": null
          }
        }
      }
