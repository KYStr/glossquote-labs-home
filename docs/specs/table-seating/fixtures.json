    {
      "id": "table-seating.backtrack",
      "kind": "solve",
      "input": {
        "tables": [
          {
            "name": "T1",
            "seats": 4,
            "stepFree": true
          },
          {
            "name": "T2",
            "seats": 4,
            "stepFree": false
          }
        ],
        "parties": [
          {
            "name": "A",
            "size": 3,
            "stepFree": false,
            "pin": null
          },
          {
            "name": "B",
            "size": 2,
            "stepFree": true,
            "pin": null
          },
          {
            "name": "C",
            "size": 1,
            "stepFree": false,
            "pin": "T2"
          }
        ]
      },
      "expected": {
        "status": "ok",
        "result": {
          "found": true,
          "tables": [
            {
              "name": "T1",
              "parties": [
                "B"
