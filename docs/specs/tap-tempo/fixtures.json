  "cases": [
    {
      "id": "steady-120",
      "kind": "core",
      "purpose": "等距敲擊 500 ms，4 個間隔，中位數與平均同為 500，BPM 120.0",
      "input": {
        "taps": [
          0,
          500,
          1000,
          1500,
          2000
        ]
      },
      "expected": {
        "ok": true,
        "result": {
          "tapCount": 5,
          "segmentStartIndex": 0,
          "segmentTapCount": 5,
          "segmentIntervalCount": 4,
          "resetCount": 0,
          "intervalCount": 4,
          "windowIntervals": [
            500,
            500,
            500,
            500
          ],
          "medianIntervalMs": 500,
          "meanIntervalMs": 500,
          "bpmMedian": 120.0,
          "bpmMean": 120.0,
          "beatsPerSecond": 2.0
        }
      }
    },
    {
      "id": "two-taps-basic",
      "kind": "core",
      "purpose": "最少可用輸入：2 次敲擊、1 個間隔 600 ms，BPM 100.0，每秒拍數 1.67",
      "input": {
        "taps": [
