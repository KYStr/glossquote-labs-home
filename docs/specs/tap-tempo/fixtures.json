    {
      "id": "state-tapping-live",
      "kind": "controller",
      "purpose": "即時敲擊路徑：逐下敲入，每下排程評估發布後讀數與核心對該前綴陣列的結果一致；跨 2000 ms 的一敲開新段落（讀數回到 null），復原上一敲與重設皆即時失效舊讀數。",
      "input": {
        "liveTaps": [
          1000,
          1500,
          2000,
          6000,
          6500
        ]
      },
      "expected": {
        "afterTap1": {
          "state": "tapping",
          "tapCount": 1,
          "intervalCount": 0,
          "bpmMedian": null,
          "downloadAvailable": false
        },
        "afterTap2": {
          "state": "tapping",
          "tapCount": 2,
          "intervalCount": 1,
          "bpmMedian": 120.0,
          "downloadAvailable": true
        },
        "afterTap3": {
          "state": "tapping",
          "tapCount": 3,
          "intervalCount": 2,
          "bpmMedian": 120.0,
          "downloadAvailable": true
        },
        "afterTap4": {
          "state": "tapping",
          "tapCount": 4,
          "intervalCount": 0,
          "bpmMedian": null,
          "resetCount": 1,
          "downloadAvailable": false
        },
        "afterTap5": {
          "state": "tapping",
          "tapCount": 5,
          "intervalCount": 1,
          "bpmMedian": 120.0,
          "downloadAvailable": true
        },
        "afterUndo": {
          "state": "tapping",
          "tapCount": 4,
          "intervalCount": 0,
          "bpmMedian": null,
          "downloadAvailable": false
        },
        "afterReset": {
          "state": "empty",
          "tapCount": 0,
          "downloadAvailable": false
        }
      }
    },
    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先以匯入文字產出真結果，再改為非遞增輸入，舊結果及下載立即失效，重新計算回 NON_MONOTONIC。",
