","input":{"calories":"off","heightCm":"260","steps":"100","strideCm":"70","strideSource":"height","weightKg":"65"},"kind":"core","purpose":"身高 260 cm 超過 250 上限"},{"expected":{"error":{"code":"RANGE","field":"strideCm","row":null},"ok":false},"id":"stride-range","input":{"calories":"off","heightCm":"170","steps":"100","strideCm":"160","strideSource":"measured","weightKg":"65"},"kind":"core","purpose":"實測步幅 160 cm 超過 150 上限"},{"expected":{"error":{"code":"DECIMAL_FORMAT","field":"strideCm","row":null},"ok":false},"id":"stride-decimal-format","input":{"calories":"off","heightCm":"170","steps":"100","strideCm":"70.456","strideSource":"measured","weightKg":"65"},"kind":"core","purpose":"實測步幅三位小數超過兩位小數文法"},{"expected":{"error":{"code":"DECIMAL_FORMAT","field":"heightCm","row":null},"ok":false},"id":"height-decimal-format","input":{"calories":"off","heightCm":"170.55","steps":"100","strideCm":"70","strideSource":"height","weightKg":"65"},"kind":"core","purpose":"身高兩位小數超過一位小數文法"},{"expected":{"error":{"code":"EMPTY","field":"weightKg","row":null},"ok":false},"id":"weight-empty-when-on","input":{"calories":"on","heightCm":"170","steps":"100","strideCm":"70","strideSource":"height","weightKg":""},"kind":"core","purpose":"熱量開啟時體重空白為 EMPTY"},{"expected":{"error":{"code":"SCHEMA","field":null,"row":null},"ok":false},"id":"schema-extra-key","input":{"calories":"off","heightCm":"170","note":"x","steps":"100","strideCm":"70","strideSource":"height","weightKg":"65"},"kind":"core","purpose":"多出未知欄位整份為 SCHEMA"},{"expected":{"afterEdit":{"reportAvailable":false,"state":"dirty"},"afterRerun":{"error":{"code":"INTEGER_FORMAT","field":"steps","row":null},"reportAvailable":false,"state":"error"},"afterRun":{"reportAvailable":true,"state":"success"}},"id":"state-dirty-error","input":{"edit":{"calories":"off","heightCm":"170","steps":"100.5","strideCm":"70","strideSource":"height","weightKg":"65"},"initial":{"calories":"off","heightCm":"170","steps":"10000","strideCm":"70","strideSource":"h