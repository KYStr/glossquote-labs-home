    {
      "id": "state-dirty-error",
      "kind": "controller",
      "purpose": "先產出真結果，再改為無效輸入，舊結果及所有下載立即失效。",
      "input": {
        "initial": {
          "knownPreset": "10k",
          "knownCustomM": "",
          "knownTime": "40:00",
          "targetCustomM": ""
        },
        "edit": {
          "knownPreset": "10k",
          "knownCustomM": "",
          "knownTime": "40:60",
          "targetCustomM": ""
        }
      },
      "expected": {
        "afterRun": {
          "state": "success",
          "reportAvailable": true
        },
        "afterEdit": {
          "state": "dirty",
          "reportAvailable": false
        },
        "afterRerun": {
          "state": "error",
          "reportAvailable": false,
          "error": {
            "code": "RANGE",
            "field": "knownTime",
            "row": null
          }
        }
      }
    },
