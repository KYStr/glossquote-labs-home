            },
            {
              "key": "marathon",
              "distanceM": 42195,
              "predictedSeconds": 11040,
              "paceSecPerKm": 261.7
            }
          ]
        }
      },
      "expected": {
        "whilePending": {
          "state": "busy",
          "reportAvailable": false
        },
        "afterCancel": {
          "state": "cancelled",
          "reportAvailable": false,
          "draft": {
            "knownPreset": "10k",
            "knownCustomM": "",
            "knownTime": "40:00",
            "targetCustomM": ""
          }
        },
        "afterLateResult": {
          "state": "cancelled",
          "reportAvailable": false
        },
        "afterReset": {
          "state": "empty",
          "reportAvailable": false,
          "draft": {
            "knownPreset": "10k",
            "knownCustomM": "",
            "knownTime": "",
            "targetCustomM": ""
          }
        }
      }
